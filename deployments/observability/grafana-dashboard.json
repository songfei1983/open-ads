{
  "title": "Open Ads services",
  "schemaVersion": 39,
  "tags": ["open-ads"],
  "timezone": "UTC",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (job) (rate(open_ads_http_requests_total[5m]))", "legendFormat": "{{job}}"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP error rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum by (job) (rate(open_ads_http_errors_total[5m])) / clamp_min(sum by (job) (rate(open_ads_http_requests_total[5m])), 1)", "legendFormat": "{{job}}"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (job, le) (rate(open_ads_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{job}}"}]
    }
  ]
}
